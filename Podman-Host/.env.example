# =====================================================================
# .env.example — Configuracion local de deploy.sh (plantilla)
# =====================================================================
# Copia este fichero a ".env" (sin .example) para personalizar el
# despliegue sin editar deploy.sh. ".env" esta en .gitignore, asi que
# tus valores (incluidas credenciales) NO se versionan.
#
#   cp .env.example .env
#
# Todas las variables son opcionales: si no defines una, se usa su valor
# por defecto (el que aparece comentado).
# =====================================================================

# --- Recursos de las VMs ---
# VCPUS=2
# MEMORY_MB=4096
# DISK_ADD_GB=16

# --- Usuario de las VMs (por defecto, el usuario que ejecuta el script) ---
# VM_USER=mi-usuario

# --- Password del usuario de las VMs (OBLIGATORIA; no hay default) ---
VM_PASSWORD=cambia-esta-password

# --- Password del admin de Jenkins (OBLIGATORIA si no usas vault.yml) ---
# Puedes definirla aqui (deploy.sh la exporta a Ansible) o en
# ansible/group_vars/all/vault.yml. Al menos una de las dos es necesaria.
JENKINS_ADMIN_PASSWORD=cambia-esta-password

# --- Comando de privilegios en el host (por defecto "sudo") ---
# SUDO=sudo
# SUDO=sudo-rs

# --- Clave SSH publica a inyectar en las VMs ---
# SSH_KEY_FILE=~/.ssh/id_ed25519.pub

# --- Directorio de discos/imagenes y propietario para libvirt ---
# STORAGE_DIR=/mnt/recursos/vms-storage
# En Debian/Ubuntu suele ser "libvirt-qemu:kvm"; en RHEL/Fedora, "qemu:qemu".
# VM_DISK_OWNER=libvirt-qemu:kvm
