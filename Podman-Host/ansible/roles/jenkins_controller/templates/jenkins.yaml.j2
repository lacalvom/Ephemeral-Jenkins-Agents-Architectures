# =====================================================================
# jenkins.yaml.j2 — Template JCasC (NO USADO por el playbook actual)
# =====================================================================
# ADVERTENCIA: ningun task de Ansible copia ni renderiza este fichero.
# Se conserva unicamente como documentacion de referencia: es lo que
# se aplicaria via JCasC si el bug de orden de carga de plugins de
# Jenkins 2.568.3 se resolviera (ver docs/adr/0003-init-groovy-vs-jcasc.md).
#
# La configuracion real y funcional de este laboratorio se aplica via
# scripts en jenkins-config/groovy/ (copiados a init.groovy.d/ por
# ansible/roles/jenkins_controller/tasks/main.yml). En particular, el
# equivalente funcional del bloque "configFileProvider:" de aqui abajo
# esta en jenkins-config/groovy/create-config-files.groovy.
#
# Si en el futuro se migra a JCasC de verdad, hay que:
#   1. Anadir una tarea `template:` que copie esto a
#      {{ jenkins_controller_home }}/casc_configs/jenkins.yaml.
#   2. Anadir -Dcasc.jenkins.config=... al JAVA_OPTS del drop-in de
#      systemd (ansible/roles/jenkins_controller/tasks/main.yml).
#   3. Retirar los scripts equivalentes de init.groovy.d/.
#
# IMPORTANTE: JCasC usa su propia sintaxis de interpolacion (doble
# llave) que coincide con Jinja2. Para evitar colisiones, este
# template SOLO usa variables Ansible (definidas en group_vars/all/vars.yml).
# El bloque configuration-as-code-groovy no usa variables.
# =====================================================================

jenkins:
  systemMessage: |
    Jenkins + Podman ephemeral agents lab.
    Configuracion gestionada por JCasC (jenkins.yaml).
    NO editar desde la UI; cualquier cambio sera sobrescrito en el siguiente
    reaprovisionamiento.

  numExecutors: 0
  mode: EXCLUSIVE
  labelString: "controller"

  securityRealm:
    local:
      allowsSignup: false
      enableCaptcha: false
      users:
        - id: "{{ jenkins_admin_user }}"
          name: "{{ jenkins_admin_user }}"
          # El password se inyecta desde Ansible como hash bcrypt
          password: "{{ jenkins_admin_password_hash }}"
          properties:
            - mailer:
                emailAddress: "admin@podman-host-lab.local"

  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false

  remotingSecurity:
    enabled: true

  # -----------------------------------------------------------------------------
  # Nodos permanentes (agentes)
  # -----------------------------------------------------------------------------
  nodes:
    - permanent:
        name: "{{ jenkins_agent_node_name }}"
        labelString: "{{ jenkins_agent_label }}"
        remoteFS: "{{ podman_agent_workspace }}"
        numExecutors: 2
        mode: NORMAL
        retentionStrategy: "always"
        launcher:
          # JNLPLauncher con WebSocket habilitado (no requiere puerto JNLP dedicado)
          jnlp:
            webSocket: true
            tunnel: ""

  globalNodeProperties:
    - envVars:
        env:
          - key: "JENKINS_PODMAN_LAB"
            value: "true"
          - key: "PODMAN_REGISTRY"
            value: "registry.access.redhat.com"

# =====================================================================
# Plugin: Docker Pipeline (docker-workflow)
# =====================================================================
docker:
  registry:
    - url: "https://registry.access.redhat.com"
      credentialsId: ""

# =====================================================================
# Plugin: Config File Provider
# =====================================================================
configFileProvider:
  managedFiles:
    - id: "maven-settings-modern"
      name: "maven-settings-modern"
      comment: "settings.xml para builds Maven del pipeline de referencia (mirror: Maven Central)"
      content: |
        <?xml version="1.0" encoding="UTF-8"?>
        <settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                                      http://maven.apache.org/xsd/settings-1.0.0.xsd">
          <!-- En un despliegue real, sustituye este mirror por el repositorio
               interno de tu organizacion (Artifactory/Nexus). -->
          <mirrors>
            <mirror>
              <id>maven-central</id>
              <name>Maven Central (mirror explicito para el laboratorio)</name>
              <url>https://repo.maven.apache.org/maven2/</url>
              <mirrorOf>*</mirrorOf>
            </mirror>
          </mirrors>
        </settings>

    - id: "npmrc-frontend"
      name: "npmrc-frontend"
      comment: ".npmrc para builds npm/Angular del pipeline de referencia (registry: npmjs.org)"
      content: |
        registry=https://registry.npmjs.org/
        strict-ssl=true

# =====================================================================
# Plugin: Build Timeout
# =====================================================================
buildTimeoutWrapper:
  timeoutMinutes: 60

# =====================================================================
# Plugin: Timestamper
# =====================================================================
timestamper:
  allPipelines: true

# =====================================================================
# Configuracion del propio JCasC (recarga en caliente)
# =====================================================================
jcasc:
  reloadToken: "podman-host-lab-reload-token"

# =====================================================================
# Plugin configuration-as-code-groovy: ejecuta scripts tras JCasC
# =====================================================================
configuration-as-code-groovy:
  scripts:
    - "groovy/init.groovy"
