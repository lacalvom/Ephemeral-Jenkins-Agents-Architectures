# Sintaxis: Containerfile para Podman (compatible con Docker)
# Imagen: agent-jdk7-ubi8
# Base: registry.access.redhat.com/ubi8/ubi-minimal
# Proposito: agente efimero con Oracle JDK 7, para proyectos legacy que
#            requieren estrictamente Java 7.
#
# IMPORTANTE: Oracle JDK 7 NO esta disponible via URL publica.
# Ver binaries/README.md para instrucciones de descarga manual.

FROM registry.access.redhat.com/ubi8/ubi-minimal:latest

# Apache Maven 3.5.4: la ULTIMA version compatible con Java 7.
# Maven 3.6.x requiere Java 7 en runtime pero oficialmente recomienda 8.
ARG MAVEN_VERSION=3.5.4

LABEL maintainer="DevOps Team" \
      description="Agente efimero Jenkins con Oracle JDK 7 y Maven 3.5.4 sobre UBI 8" \
      version="1.0.0" \
      io.jenkins-podman-lab.component="legacy-agent-jdk7"

RUN microdnf install -y --setopt=install_weak_deps=0 --best \
        tar \
        gzip \
        shadow-utils \
        ca-certificates \
    && microdnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum

# Usuario no-privilegiado (UID 1001, --userns=keep-id).
RUN groupadd -g 1001 jenkins_agent && \
    useradd -u 1001 -g 1001 -m -s /bin/bash jenkins_agent

# Copiamos el binario de Oracle JDK 7 desde el contexto de build.
# El usuario debe descargarlo manualmente y ponerlo en binaries/.
COPY binaries/jdk-7u80-linux-x64.tar.gz /tmp/jdk-installer.tar.gz
RUN mkdir -p /opt/jdk7 \
    && tar -xzf /tmp/jdk-installer.tar.gz -C /opt/jdk7 --strip-components=1 \
    && rm -f /tmp/jdk-installer.tar.gz \
    && chown -R root:root /opt/jdk7 \
    && chmod -R 0755 /opt/jdk7

ENV JAVA_HOME=/opt/jdk7 \
    MAVEN_HOME=/opt/maven \
    PATH=/opt/jdk7/bin:/opt/maven/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Instalamos Maven 3.5.4 (ultima compatible con Java 7).
RUN curl -fSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" -o /tmp/maven.tar.gz \
    && mkdir -p /opt/maven \
    && tar -xzf /tmp/maven.tar.gz -C /opt/maven --strip-components=1 \
    && rm -f /tmp/maven.tar.gz \
    && chown -R root:root /opt/maven \
    && chmod -R 0755 /opt/maven

# Verificacion: java 7 y maven 3.5.4.
RUN java -version 2>&1 | grep -qE '"1\.7\.' \
    && mvn --version 2>&1 | grep -qE 'Apache Maven '"${MAVEN_VERSION}" \
    || (echo "ERROR: versiones incorrectas" && java -version && mvn --version && exit 1)

USER 1001

CMD ["/bin/bash"]
