# Sintaxis: Containerfile para Podman (compatible con Docker)
# Imagen: agent-node8-ubi8
# Base: registry.access.redhat.com/ubi8/ubi-minimal
# Proposito: agente efimero con Node.js 8 (EOL), para proyectos legacy
#            Angular 5/6/7 que requieren esta version.

FROM registry.access.redhat.com/ubi8/ubi-minimal:latest

# Node.js 8.17.0: la ULTIMA version de la rama 8.x (EOL abril 2022).
# Despues de esta, npm empieza a fallar con muchos paquetes legacy.
ARG NODE_VERSION=8.17.0

LABEL maintainer="DevOps Team" \
      description="Agente efimero Jenkins con Node.js 8.17.0 sobre UBI 8" \
      version="1.0.0" \
      io.jenkins-podman-lab.component="legacy-agent-node8"

RUN microdnf install -y --setopt=install_weak_deps=0 --best \
        tar \
        xz \
        gzip \
        shadow-utils \
        ca-certificates \
    && microdnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum

# Usuario no-privilegiado (UID 1001, --userns=keep-id).
RUN groupadd -g 1001 jenkins_agent && \
    useradd -u 1001 -g 1001 -m -s /bin/bash jenkins_agent

ENV NODE_HOME=/opt/node \
    PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Descargamos Node desde nodejs.org.
# NOTA: usamos --strip-components=1 para que el contenido del tarball
# quede directamente en /opt/node (sin el subdirectorio node-vXXX).
RUN curl -fSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz \
    && mkdir -p /opt/node \
    && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1 \
    && rm -f /tmp/node.tar.xz \
    && chown -R root:root /opt/node \
    && chmod -R 0755 /opt/node

# Verificacion: la version de Node coincide con la solicitada.
RUN node --version | grep -q "v${NODE_VERSION}" || \
    (echo "ERROR: version de Node incorrecta" && exit 1)

USER 1001

CMD ["/bin/bash"]
