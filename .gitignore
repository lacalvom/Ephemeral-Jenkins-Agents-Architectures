# =====================================================================
# .gitignore de Ephemeral-Jenkins-Agents-Architectures
# =====================================================================

# --- Artefactos generados por los labs (cloud images, discos qcow2,
# ISOs de cloud-init y user-data/meta-data con datos de la maquina) ---
# Se regeneran en cada ejecucion de deploy.sh; no deben versionarse.
*/aux-files/*
!*/aux-files/.gitkeep

# --- Ansible ---
*.retry
.ansible/

# --- Secretos locales (no versionar; plantillas en *.example) ---
# Ansible: vault por lab
*/ansible/group_vars/all/vault.yml
# deploy.sh: configuracion local por lab
*/.env

# --- Python (helper bcrypt y similares) ---
__pycache__/
*.py[cod]

# --- Editores / SO ---
.vscode/
.idea/
*.swp
.DS_Store

# --- Logs ---
*.log
