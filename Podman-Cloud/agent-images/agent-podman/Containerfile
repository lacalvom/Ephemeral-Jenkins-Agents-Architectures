# =====================================================================
# agent-podman — agente Jenkins (JDK 21) con Podman + herramientas k8s
# =====================================================================
# Imagen-agente hibrida para el modelo Podman-Cloud:
#   - El agente corre sobre el JDK 21 de la imagen base.
#   - Incluye el cliente Podman (habla con el motor del HOST a traves
#     del socket que monta la plantilla: CONTAINER_HOST).
#   - Incluye kubectl, kubectx y kubens. El kubeconfig NO se hornea:
#     se inyecta en tiempo de build del pipeline (Config File Provider).
#
# Base UBI 9 (RHEL 9), alineada con AlmaLinux 9 del resto del lab.
# =====================================================================
FROM docker.io/jenkins/inbound-agent:latest-rhel-ubi9-jdk21

USER root

# NOTA: UBI 9 ya trae "curl-minimal" (provee el binario curl); pedir el
# paquete "curl" entra en conflicto con el. Por eso no se instala aqui.
RUN dnf install -y --disableplugin=subscription-manager \
      --setopt=install_weak_deps=0 --setopt=tsflags=nodocs \
      ca-certificates \
      git \
      jq \
      gzip \
      podman \
 && dnf clean --disableplugin=subscription-manager all

# kubectl (cliente oficial de Kubernetes)
RUN KUBECTL_VERSION="$(curl -fsSL https://dl.k8s.io/release/stable.txt)" \
 && curl -fsSL -o /usr/local/bin/kubectl \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
 && chmod +x /usr/local/bin/kubectl

# kubectx y kubens (cambio rapido de contexto/namespace)
RUN git clone --depth 1 https://github.com/ahmetb/kubectx /opt/kubectx \
 && ln -s /opt/kubectx/kubectx /usr/local/bin/kubectx \
 && ln -s /opt/kubectx/kubens /usr/local/bin/kubens \
 && rm -rf /opt/kubectx/.git

USER jenkins
