# Extensiones X.509 del certificado de SERVIDOR de la API de Podman.
# Este fichero lo consume "openssl x509 -extfile", asi que NO puede llevar
# cabeceras YAML ni separadores "---": solo directivas de OpenSSL.
subjectAltName = IP:{{ podman_tls_server_ip }}, DNS:{{ podman_tls_server_dns }}
extendedKeyUsage = serverAuth
keyUsage = digitalSignature, keyEncipherment
